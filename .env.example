# Form submissions are always saved to Netlify Blobs. To ALSO receive an
# email for every submission, configure SMTP below (set these in the
# Netlify dashboard under Site settings -> Environment variables).
#
# Google Workspace setup for SMTP_PASS:
#   1. Sign in to the mailbox you want to send from (e.g. contact@backpackkidz.com).
#   2. Google Account -> Security -> enable 2-Step Verification.
#   3. Google Account -> Security -> App passwords -> create one for "Mail".
#   4. Use that 16-character app password as SMTP_PASS.
# If SMTP_USER/SMTP_PASS are not set, emails are skipped (submissions still save).
SMTP_USER=
SMTP_PASS=

# Optional SMTP overrides (defaults: smtp.gmail.com, port 465).
SMTP_HOST=
SMTP_PORT=

# Optional: From address for notification emails; defaults to SMTP_USER.
NOTIFY_FROM=

# Optional: who receives each kind of form submission. Defaults:
#   contacts -> contact@backpackkidz.com    donations    -> donate@backpackkidz.com
#   sponsorships -> donate@backpackkidz.com volunteers   -> contact@backpackkidz.com
#   partners -> partners@backpackkidz.com
CONTACTS_NOTIFY_EMAIL=
DONATIONS_NOTIFY_EMAIL=
SPONSORSHIPS_NOTIFY_EMAIL=
VOLUNTEERS_NOTIFY_EMAIL=
PARTNERS_NOTIFY_EMAIL=

# Optional: required only for the private donation records CSV export page.
DONATIONS_EXPORT_TOKEN=

# Optional: required only for the private volunteer records CSV export.
VOLUNTEERS_EXPORT_TOKEN=

# Optional: required only for the private sponsorship records CSV export.
SPONSORSHIPS_EXPORT_TOKEN=

# Optional: required only for the private contact / inquiry records CSV export.
CONTACTS_EXPORT_TOKEN=

# Optional: required only for the private partner records CSV export.
PARTNERS_EXPORT_TOKEN=

# Optional: overrides the default PayPal continuation link.
PAYPAL_DONATION_URL=https://www.paypal.com/donate/?hosted_button_id=VSXH3DH6PUFH2
